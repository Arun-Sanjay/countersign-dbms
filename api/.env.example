# Copy to api/.env (git-ignored). Every value is optional; defaults in app/config.py.
# Supabase: local stack by default (values read from `npx supabase status -o env`).
SUPABASE_TARGET=local            # local | remote (remote reads web/.env.remote)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<publishable anon key only; never a service key>
# MongoDB: Atlas by default (URI read from ../atlas-credentials.env if MONGODB_URI is unset).
MONGO_TARGET=atlas               # atlas | local (docker elp-mongo-local on 127.0.0.1:57018)
# MONGODB_URI=mongodb+srv://...  # a limited app user in production, not the atlasAdmin URI
MONGO_DB=elp
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ---- Ingestion worker (app/worker.py, POST /ingest/drain). Local stack: read from `supabase status`.
# INGEST_BACKEND=rest            # rest (service key via PostgREST) | sql (psycopg on INGEST_DB_URL)
# SUPABASE_SERVICE_ROLE_KEY=     # worker only; never used for a user request; never commit
# INGEST_DB_URL=                 # alternative to the service key: a Postgres URL
# ---- Optional AI providers: absent = skipped, keyword search + extractive answers still work
# VOYAGE_API_KEY=                # chunk + query embeddings (hybrid retrieval)
# VOYAGE_MODEL=voyage-4          # 1024 dims; stored in artifact_chunk.embedding_model
# ANTHROPIC_API_KEY=             # generative /ask answers with verified citations
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional (worker): fetch pushed markdown from the GitHub contents API, so a REAL push (paths
# only, no file bodies) still produces chunks and Mongo notes. Off by default; the replay
# fixtures carry the text inline. The token is needed for a private repository.
# GITHUB_FETCH_CONTENTS=1
# GITHUB_TOKEN=
