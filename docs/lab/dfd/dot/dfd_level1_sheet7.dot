digraph L1 {
  graph [fontname="Helvetica", fontsize=20, labelloc=t, labeljust=l, pad=0.15,
         nodesep=0.19, ranksep=0.35, rankdir=LR, splines=true, newrank=true,
         label=<<b>DFD Level 1, sheet 7 of 8: process 7.0 Answer questions with citations</b>>];
  node  [fontname="Helvetica", fontsize=16];
  edge  [fontname="Helvetica", fontsize=14, arrowsize=1.0];
  "STU@7.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3" style="dashed"><tr><td rowspan="3" cellpadding="10"><font point-size="20"><b>Student</b><br/><b>[planned]</b></font></td><td port="p0" height="32" width="2"></td></tr><tr><td port="p1" height="32" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "FAC@7.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3" style="dashed"><tr><td rowspan="3" cellpadding="10"><font point-size="20"><b>Faculty</b><br/><b>[planned]</b></font></td><td port="p0" height="32" width="2"></td></tr><tr><td port="p1" height="32" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "AI@7.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3" style="dashed"><tr><td rowspan="3" cellpadding="10"><font point-size="20"><b>AI model</b><br/><b>services (Claude</b><br/><b>API, Voyage AI)</b><br/><b>[planned]</b></font></td><td port="p0" height="44" width="2"></td></tr><tr><td port="p1" height="44" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "D4@7.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D4</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Work record</b></font><br/><font point-size="16">artifact, artifact_version,<br/>contribution</font></td></tr></table>>];
  "D5@7.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="62" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D5</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Text chunks</b></font><br/><font point-size="16">artifact_chunk</font></td></tr></table>>];
  "D6@7.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D6</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Claims</b></font><br/><font point-size="16">claim, claim_evidence,<br/>countersign</font></td></tr></table>>];
  "7.0" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded,dashed" bgcolor="#f7f7f7"><tr><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td height="1" width="2"></td></tr><tr><td port="LF37" height="32" width="2"></td></tr><tr><td port="LF39" height="46" width="2"></td></tr><tr><td port="LF38" height="32" width="2"></td></tr><tr><td port="LF40" height="46" width="2"></td></tr><tr><td port="LF41" height="44" width="2"></td></tr><tr><td port="LF42" height="58" width="2"></td></tr><tr><td height="1" width="2"></td></tr></table></td><td sides="b" border="1" height="30" width="230"><font point-size="16"><b>7.0</b></font></td><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="RS45" height="92" width="2"></td></tr><tr><td port="RS46" height="76" width="2"></td></tr><tr><td port="RS47" height="92" width="2"></td></tr></table></td></tr><tr><td height="176"><font point-size="20"><b>Answer questions<br/>with citations<br/>[planned]</b></font></td></tr><tr><td sides="t" border="1" height="54"><font point-size="16" color="#333333">search_chunks(), /rag/ask<br/>[planned]</font></td></tr></table>>];
  { rank=same; "STU@7.0"; "FAC@7.0"; "AI@7.0"; }
  "STU@7.0" -> "FAC@7.0" -> "AI@7.0" [style=invis];
  { rank=same; "7.0"; }
  { rank=same; "D4@7.0"; "D5@7.0"; "D6@7.0"; }
  "D4@7.0" -> "D5@7.0" -> "D6@7.0" [style=invis];
  "STU@7.0":p0:e -> "7.0":LF37:w [label="F37  question [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, style=dashed];
  "STU@7.0":p1:e -> "7.0":LF39:w [label="F39  cited answer [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
  "FAC@7.0":p0:e -> "7.0":LF38:w [label="F38  question [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, style=dashed];
  "FAC@7.0":p1:e -> "7.0":LF40:w [label="F40  cited answer [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
  "AI@7.0":p0:e -> "7.0":LF41:w [label="F41  question and permitted\nchunks (prompt) [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
  "AI@7.0":p1:e -> "7.0":LF42:w [label="F42  query embedding and cited\ndraft answer [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, style=dashed];
  "7.0":RS45:e -> "D4@7.0":p0:w [label="S45  artifact (citation\nmetadata) [planned]", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back, style=dashed];
  "7.0":RS46:e -> "D5@7.0":p0:w [label="S46  artifact_chunk (tsv,\nembedding), RLS-filtered\n[planned]", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back, style=dashed];
  "7.0":RS47:e -> "D6@7.0":p0:w [label="S47  claim (confirmed) [planned]", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back, style=dashed];
}
