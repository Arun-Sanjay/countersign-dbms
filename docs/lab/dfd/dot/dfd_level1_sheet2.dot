digraph L1 {
  graph [fontname="Helvetica", fontsize=20, labelloc=t, labeljust=l, pad=0.15,
         nodesep=0.19, ranksep=0.35, rankdir=LR, splines=true, newrank=true,
         label=<<b>DFD Level 1, sheet 2 of 8: process 2.0 Form teams</b>>];
  node  [fontname="Helvetica", fontsize=16];
  edge  [fontname="Helvetica", fontsize=14, arrowsize=1.0];
  "ADM@2.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="2" cellpadding="10"><font point-size="20"><b>College Admin</b></font></td><td port="p0" height="64" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "STU@2.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="3" cellpadding="10"><font point-size="20"><b>Student</b></font></td><td port="p0" height="32" width="2"></td></tr><tr><td port="p1" height="32" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "D6@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D6</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Claims</b></font><br/><font point-size="16">claim, claim_evidence,<br/>countersign</font></td><td port="p0" height="78" width="2"></td></tr></table>>];
  "D7@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D7</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Submissions</b></font><br/><font point-size="16">submission,<br/>submission_artifact</font></td><td port="p0" height="78" width="2"></td></tr></table>>];
  "D8@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D8</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Assessments</b></font><br/><font point-size="16">assessment</font></td><td port="p0" height="58" width="2"></td></tr></table>>];
  "D1@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="118" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D1</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Directory and enrollment</b></font><br/><font point-size="16">student, faculty, course,<br/>academic_term,<br/>course_offering, enrollment,<br/>app_user</font></td></tr></table>>];
  "D2@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D2</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Projects and components</b></font><br/><font point-size="16">project, milestone</font></td></tr></table>>];
  "D3@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D3</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Teams</b></font><br/><font point-size="16">team, team_member</font></td></tr></table>>];
  "D4@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D4</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Work record</b></font><br/><font point-size="16">artifact, artifact_version,<br/>contribution</font></td></tr></table>>];
  "D5@2.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D5</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Text chunks</b></font><br/><font point-size="16">artifact_chunk</font></td></tr></table>>];
  "2.0" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#f3f6fb"><tr><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td height="14" width="2"></td></tr><tr><td port="LF08" height="78" width="2"></td></tr><tr><td port="LF09" height="32" width="2"></td></tr><tr><td port="LF10" height="46" width="2"></td></tr><tr><td port="LS12" height="92" width="2"></td></tr><tr><td port="LS13" height="92" width="2"></td></tr><tr><td port="LS14" height="72" width="2"></td></tr><tr><td height="14" width="2"></td></tr></table></td><td sides="b" border="1" height="30" width="230"><font point-size="16"><b>2.0</b></font></td><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="RS07" height="132" width="2"></td></tr><tr><td port="RS08" height="72" width="2"></td></tr><tr><td port="RS09" height="72" width="2"></td></tr><tr><td port="RS10" height="92" width="2"></td></tr><tr><td port="RS11" height="72" width="2"></td></tr></table></td></tr><tr><td height="356"><font point-size="20"><b>Form teams</b></font></td></tr><tr><td sides="t" border="1" height="54"><font point-size="16" color="#333333">join_team(), leave_team();<br/>trg_team_member_history_guard</font></td></tr></table>>];
  { rank=same; "ADM@2.0"; "STU@2.0"; "D6@2.0"; "D7@2.0"; "D8@2.0"; }
  "ADM@2.0" -> "STU@2.0" -> "D6@2.0" -> "D7@2.0" -> "D8@2.0" [style=invis];
  { rank=same; "2.0"; }
  { rank=same; "D1@2.0"; "D2@2.0"; "D3@2.0"; "D4@2.0"; "D5@2.0"; }
  "D1@2.0" -> "D2@2.0" -> "D3@2.0" -> "D4@2.0" -> "D5@2.0" [style=invis];
  "ADM@2.0":p0:e -> "2.0":LF08:w [label="F08  team definitions and\nplacements", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU@2.0":p0:e -> "2.0":LF09:w [label="F09  join / leave request", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU@2.0":p1:e -> "2.0":LF10:w [label="F10  membership result", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "D6@2.0":p0:e -> "2.0":LS12:w [label="S12  claim.usn,\ncountersign.endorser_usn", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6];
  "D7@2.0":p0:e -> "2.0":LS13:w [label="S13  submission.submitted_by", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6];
  "D8@2.0":p0:e -> "2.0":LS14:w [label="S14  assessment.usn", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6];
  "2.0":RS07:e -> "D1@2.0":p0:w [label="S07  enrollment", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "2.0":RS08:e -> "D2@2.0":p0:w [label="S08  project (offering_id)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "2.0":RS09:e -> "D3@2.0":p0:w [label="S09  team, team_member", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "2.0":RS10:e -> "D4@2.0":p0:w [label="S10  artifact.owner_usn,\ncontribution.usn,\nartifact_version.created_by", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "2.0":RS11:e -> "D5@2.0":p0:w [label="S11  artifact_chunk.author_usn", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
}
