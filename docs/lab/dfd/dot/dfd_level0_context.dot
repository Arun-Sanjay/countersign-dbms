digraph L0 {
  graph [fontname="Helvetica", fontsize=20, labelloc=t, labeljust=l, pad=0.15,
         nodesep=0.19, ranksep=0.5, rankdir=LR, splines=true, newrank=true,
         label=<<b>DFD Level 0 (context diagram): Countersign</b>>];
  node  [fontname="Helvetica", fontsize=16];
  edge  [fontname="Helvetica", fontsize=14, arrowsize=1.0];
  "STU" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="13" cellpadding="10"><font point-size="20"><b>Student</b></font></td><td port="p0" height="26" width="2"></td></tr><tr><td port="p1" height="26" width="2"></td></tr><tr><td port="p2" height="44" width="2"></td></tr><tr><td port="p3" height="26" width="2"></td></tr><tr><td port="p4" height="44" width="2"></td></tr><tr><td port="p5" height="44" width="2"></td></tr><tr><td port="p6" height="26" width="2"></td></tr><tr><td port="p7" height="44" width="2"></td></tr><tr><td port="p8" height="26" width="2"></td></tr><tr><td port="p9" height="26" width="2"></td></tr><tr><td port="p10" height="44" width="2"></td></tr><tr><td port="p11" height="26" width="2"></td></tr><tr><td height="2" width="2"></td></tr></table>>];
  "AI" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3" style="dashed"><tr><td rowspan="3" cellpadding="10"><font point-size="20"><b>AI model</b><br/><b>services (Claude</b><br/><b>API, Voyage AI)</b><br/><b>[planned]</b></font></td><td port="p0" height="44" width="2"></td></tr><tr><td port="p1" height="44" width="2"></td></tr><tr><td height="2" width="2"></td></tr></table>>];
  "FAC" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td port="p0" height="26" width="2"></td><td rowspan="9" cellpadding="10"><font point-size="20"><b>Faculty</b></font></td><td rowspan="8" width="2"></td></tr><tr><td port="p1" height="26" width="2"></td></tr><tr><td port="p2" height="44" width="2"></td></tr><tr><td port="p3" height="26" width="2"></td></tr><tr><td port="p4" height="26" width="2"></td></tr><tr><td port="p5" height="26" width="2"></td></tr><tr><td port="p6" height="26" width="2"></td></tr><tr><td port="p7" height="44" width="2"></td></tr><tr><td height="2" width="2"></td><td height="2" width="2"></td></tr></table>>];
  "ADM" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td port="p0" height="26" width="2"></td><td rowspan="8" cellpadding="10"><font point-size="20"><b>College Admin</b></font></td><td rowspan="7" width="2"></td></tr><tr><td port="p1" height="26" width="2"></td></tr><tr><td port="p2" height="44" width="2"></td></tr><tr><td port="p3" height="26" width="2"></td></tr><tr><td port="p4" height="44" width="2"></td></tr><tr><td port="p5" height="26" width="2"></td></tr><tr><td port="p6" height="26" width="2"></td></tr><tr><td height="2" width="2"></td><td height="2" width="2"></td></tr></table>>];
  "GH" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3" style="dashed"><tr><td port="p0" height="64" width="2"></td><td rowspan="2" cellpadding="10"><font point-size="20"><b>GitHub</b><br/><b>(team repository)</b><br/><b>[planned]</b></font></td><td rowspan="1" width="2"></td></tr><tr><td height="2" width="2"></td><td height="2" width="2"></td></tr></table>>];
  "OBS" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3" style="dashed"><tr><td port="p0" height="64" width="2"></td><td rowspan="2" cellpadding="10"><font point-size="20"><b>Obsidian vault</b><br/><b>(in team</b><br/><b>repository)</b><br/><b>[planned]</b></font></td><td rowspan="1" width="2"></td></tr><tr><td height="2" width="2"></td><td height="2" width="2"></td></tr></table>>];
  "SYS" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#f3f6fb"><tr><td rowspan="2" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td height="44" width="2"></td></tr><tr><td port="LC01" height="26" width="2"></td></tr><tr><td port="LC02" height="26" width="2"></td></tr><tr><td port="LC03" height="44" width="2"></td></tr><tr><td port="LC04" height="26" width="2"></td></tr><tr><td port="LC05" height="44" width="2"></td></tr><tr><td port="LC06" height="44" width="2"></td></tr><tr><td port="LC07" height="26" width="2"></td></tr><tr><td port="LC08" height="44" width="2"></td></tr><tr><td port="LC09" height="26" width="2"></td></tr><tr><td port="LC10" height="26" width="2"></td></tr><tr><td port="LC11" height="44" width="2"></td></tr><tr><td port="LC12" height="40" width="2"></td></tr><tr><td port="LC26" height="44" width="2"></td></tr><tr><td port="LC27" height="58" width="2"></td></tr><tr><td height="44" width="2"></td></tr></table></td><td sides="b" border="1" height="30" width="220"><font point-size="16"><b>0</b></font></td><td rowspan="2" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="RC13" height="26" width="2"></td></tr><tr><td port="RC14" height="26" width="2"></td></tr><tr><td port="RC15" height="44" width="2"></td></tr><tr><td port="RC16" height="26" width="2"></td></tr><tr><td port="RC17" height="26" width="2"></td></tr><tr><td port="RC18" height="26" width="2"></td></tr><tr><td port="RC19" height="26" width="2"></td></tr><tr><td port="RC28" height="58" width="2"></td></tr><tr><td port="RC20" height="26" width="2"></td></tr><tr><td port="RC21" height="26" width="2"></td></tr><tr><td port="RC22" height="44" width="2"></td></tr><tr><td port="RC23" height="26" width="2"></td></tr><tr><td port="RC29" height="44" width="2"></td></tr><tr><td port="RC30" height="26" width="2"></td></tr><tr><td port="RC31" height="40" width="2"></td></tr><tr><td port="RC24" height="58" width="2"></td></tr><tr><td port="RC25" height="58" width="2"></td></tr></table></td></tr><tr><td height="576"><font point-size="20"><b>Countersign<br/>(the whole system)</b></font></td></tr></table>>];
  { rank=same; "STU"; "AI"; }
  { rank=same; "FAC"; "ADM"; "GH"; "OBS"; }
  "STU" -> "AI" [style=invis];
  "FAC" -> "ADM" -> "GH" -> "OBS" [style=invis];
  "STU":p0:e -> "SYS":LC01:w [label="C01  team join / leave requests", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU":p1:e -> "SYS":LC02:w [label="C02  authored work, team notes and private notes", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU":p2:e -> "SYS":LC03:w [label="C03  claims, evidence and verdicts (incl.\namendments, withdrawals)", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU":p3:e -> "SYS":LC04:w [label="C04  component submissions", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU":p4:e -> "SYS":LC05:w [label="C05  declared skills, matching queries and\npreview requests", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU":p5:e -> "SYS":LC06:w [label="C06  questions and portfolio export requests\n[planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, style=dashed];
  "STU":p6:e -> "SYS":LC07:w [label="C07  semester hub and membership results", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU":p7:e -> "SYS":LC08:w [label="C08  version history, team notes, own private\nnotes, consistency report", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU":p8:e -> "SYS":LC09:w [label="C09  claim receipts, status and countersign queue", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU":p9:e -> "SYS":LC10:w [label="C10  submission receipts, own marks and lab CIE", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU":p10:e -> "SYS":LC11:w [label="C11  teammate suggestions, skill gap and\nfaculty-view preview", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU":p11:e -> "SYS":LC12:w [label="C12  cited answers and portfolio export [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
  "AI":p0:e -> "SYS":LC26:w [label="C26  text to embed and permission-filtered\nprompts [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
  "AI":p1:e -> "SYS":LC27:w [label="C27  embeddings and drafted cited answers\n[planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, style=dashed];
  "SYS":RC13:e -> "FAC":p0:w [label="C13  marks entries and component locks", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "SYS":RC14:e -> "FAC":p1:w [label="C14  questions [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
  "SYS":RC15:e -> "FAC":p2:w [label="C15  rubric sheet, progress, lab CIE, receipts\nand lock summaries", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC16:e -> "FAC":p3:w [label="C16  submitted work", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC17:e -> "FAC":p4:w [label="C17  contested claims and claim trail", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC18:e -> "FAC":p5:w [label="C18  taught offerings and project summaries", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC19:e -> "FAC":p6:w [label="C19  cited answers [planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, style=dashed];
  "SYS":RC28:e -> "FAC":p7:w [label="C28  note metadata, version receipts and\nconsistency report", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC20:e -> "ADM":p0:w [label="C20  directory, term and enrollment records", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "SYS":RC21:e -> "ADM":p1:w [label="C21  project, component and team definitions", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "SYS":RC22:e -> "ADM":p2:w [label="C22  skill taxonomy, required skills, course\nconcepts, verified levels", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "SYS":RC23:e -> "ADM":p3:w [label="C23  directory listings and institution totals", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC29:e -> "ADM":p4:w [label="C29  component locks / unlocks and mark\ncorrections", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "SYS":RC30:e -> "ADM":p5:w [label="C30  oversight reports and lock summaries", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC31:e -> "ADM":p6:w [label="C31  portfolio rebuild report", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "SYS":RC24:e -> "GH":p0:w [label="C24  push events (commits, authors, files)\n[planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
  "SYS":RC25:e -> "OBS":p0:w [label="C25  vault notes (markdown + frontmatter)\n[planned]", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back, style=dashed];
}
