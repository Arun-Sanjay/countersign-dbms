digraph L1 {
  graph [fontname="Helvetica", fontsize=20, labelloc=t, labeljust=l, pad=0.15,
         nodesep=0.19, ranksep=0.35, rankdir=LR, splines=true, newrank=true,
         label=<<b>DFD Level 1, sheet 5 of 8: process 5.0 Submit and assess components</b>>];
  node  [fontname="Helvetica", fontsize=16];
  edge  [fontname="Helvetica", fontsize=14, arrowsize=1.0];
  "ADM@5.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="5" cellpadding="10"><font point-size="20"><b>College Admin</b></font></td><td port="p0" height="26" width="2"></td></tr><tr><td port="p1" height="44" width="2"></td></tr><tr><td port="p2" height="26" width="2"></td></tr><tr><td port="p3" height="44" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "STU@5.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="4" cellpadding="10"><font point-size="20"><b>Student</b></font></td><td port="p0" height="26" width="2"></td></tr><tr><td port="p1" height="26" width="2"></td></tr><tr><td port="p2" height="26" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "FAC@5.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="7" cellpadding="10"><font point-size="20"><b>Faculty</b></font></td><td port="p0" height="26" width="2"></td></tr><tr><td port="p1" height="26" width="2"></td></tr><tr><td port="p2" height="44" width="2"></td></tr><tr><td port="p3" height="44" width="2"></td></tr><tr><td port="p4" height="26" width="2"></td></tr><tr><td port="p5" height="26" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "D7@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D7</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Submissions</b></font><br/><font point-size="16">submission,<br/>submission_artifact</font></td><td port="p0" height="78" width="2"></td></tr></table>>];
  "D8@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D8</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Assessments</b></font><br/><font point-size="16">assessment</font></td><td port="p0" height="58" width="2"></td></tr></table>>];
  "D1@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="118" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D1</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Directory and enrollment</b></font><br/><font point-size="16">student, faculty, course,<br/>academic_term,<br/>course_offering, enrollment,<br/>app_user</font></td></tr></table>>];
  "D2@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D2</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Projects and components</b></font><br/><font point-size="16">project, milestone</font></td></tr></table>>];
  "D3@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D3</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Teams</b></font><br/><font point-size="16">team, team_member</font></td></tr></table>>];
  "D4@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D4</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Work record</b></font><br/><font point-size="16">artifact, artifact_version,<br/>contribution</font></td></tr></table>>];
  "D5@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D5</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Text chunks</b></font><br/><font point-size="16">artifact_chunk</font></td></tr></table>>];
  "D6@5.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D6</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Claims</b></font><br/><font point-size="16">claim, claim_evidence,<br/>countersign</font></td></tr></table>>];
  "5.0" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#f3f6fb"><tr><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="LF51" height="26" width="2"></td></tr><tr><td port="LF52" height="44" width="2"></td></tr><tr><td port="LF53" height="26" width="2"></td></tr><tr><td port="LF54" height="58" width="2"></td></tr><tr><td port="LF24" height="26" width="2"></td></tr><tr><td port="LF25" height="26" width="2"></td></tr><tr><td port="LF26" height="40" width="2"></td></tr><tr><td port="LF27" height="26" width="2"></td></tr><tr><td port="LF28" height="26" width="2"></td></tr><tr><td port="LF29" height="44" width="2"></td></tr><tr><td port="LF30" height="44" width="2"></td></tr><tr><td port="LF31" height="26" width="2"></td></tr><tr><td port="LF32" height="40" width="2"></td></tr><tr><td port="LS36" height="92" width="2"></td></tr><tr><td port="LS37" height="72" width="2"></td></tr></table></td><td sides="b" border="1" height="30" width="230"><font point-size="16"><b>5.0</b></font></td><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td height="42" width="2"></td></tr><tr><td port="RS30" height="132" width="2"></td></tr><tr><td port="RS31" height="72" width="2"></td></tr><tr><td port="RS32" height="72" width="2"></td></tr><tr><td port="RS33" height="92" width="2"></td></tr><tr><td port="RS34" height="72" width="2"></td></tr><tr><td port="RS35" height="92" width="2"></td></tr><tr><td height="42" width="2"></td></tr></table></td></tr><tr><td height="512"><font point-size="20"><b>Submit and assess<br/>components</b></font></td></tr><tr><td sides="t" border="1" height="74"><font point-size="16" color="#333333">submit_milestone(),<br/>record_assessment(),<br/>lock_milestone(); rubric views</font></td></tr></table>>];
  { rank=same; "ADM@5.0"; "STU@5.0"; "FAC@5.0"; "D7@5.0"; "D8@5.0"; }
  "ADM@5.0" -> "STU@5.0" -> "FAC@5.0" -> "D7@5.0" -> "D8@5.0" [style=invis];
  { rank=same; "5.0"; }
  { rank=same; "D1@5.0"; "D2@5.0"; "D3@5.0"; "D4@5.0"; "D5@5.0"; "D6@5.0"; }
  "D1@5.0" -> "D2@5.0" -> "D3@5.0" -> "D4@5.0" -> "D5@5.0" -> "D6@5.0" [style=invis];
  "ADM@5.0":p0:e -> "5.0":LF51:w [label="F51  component lock / unlock", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "ADM@5.0":p1:e -> "5.0":LF52:w [label="F52  mark correction (insert,\nupdate, delete)", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "ADM@5.0":p2:e -> "5.0":LF53:w [label="F53  component-lock summary", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "ADM@5.0":p3:e -> "5.0":LF54:w [label="F54  rubric sheet, progress,\nsubmitted work, lab CIE", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU@5.0":p0:e -> "5.0":LF24:w [label="F24  submission request", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU@5.0":p1:e -> "5.0":LF25:w [label="F25  submission receipt", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU@5.0":p2:e -> "5.0":LF26:w [label="F26  own marks and lab CIE", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "FAC@5.0":p0:e -> "5.0":LF27:w [label="F27  marks entry", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "FAC@5.0":p1:e -> "5.0":LF28:w [label="F28  component lock", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "FAC@5.0":p2:e -> "5.0":LF29:w [label="F29  assessment receipt and lock\nsummary", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "FAC@5.0":p3:e -> "5.0":LF30:w [label="F30  rubric sheet and team\nprogress", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "FAC@5.0":p4:e -> "5.0":LF31:w [label="F31  submitted work", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "FAC@5.0":p5:e -> "5.0":LF32:w [label="F32  class lab CIE marks", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "D7@5.0":p0:e -> "5.0":LS36:w [label="S36  submission,\nsubmission_artifact\n[append]", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "D8@5.0":p0:e -> "5.0":LS37:w [label="S37  assessment", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "5.0":RS30:e -> "D1@5.0":p0:w [label="S30  student, course,\ncourse_offering (teacher)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "5.0":RS31:e -> "D2@5.0":p0:w [label="S31  milestone (max_marks,\ncie_part, locked_at)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "5.0":RS32:e -> "D3@5.0":p0:w [label="S32  team, team_member", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "5.0":RS33:e -> "D4@5.0":p0:w [label="S33  artifact.visibility,\nartifact_version.version_no", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "5.0":RS34:e -> "D5@5.0":p0:w [label="S34  artifact_chunk (visibility,\nsubmitted text)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "5.0":RS35:e -> "D6@5.0":p0:w [label="S35  claim (status counts)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
}
