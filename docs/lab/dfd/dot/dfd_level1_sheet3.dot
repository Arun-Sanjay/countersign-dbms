  "3.0" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#f3f6fb"><tr><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td height="12" width="2"></td></tr><tr><td port="LF59" height="78" width="2"></td></tr><tr><td port="LF11" height="78" width="2"></td></tr><tr><td port="LF12" height="78" width="2"></td></tr><tr><td port="LF13" height="44" width="2"></td></tr><tr><td port="LF47" height="44" width="2"></td></tr><tr><td port="LF14" height="26" width="2"></td></tr><tr><td port="LF15" height="44" width="2"></td></tr><tr><td port="LF48" height="44" width="2"></td></tr><tr><td port="LF57" height="58" width="2"></td></tr><tr><td port="LF49" height="62" width="2"></td></tr><tr><td port="LF58" height="58" width="2"></td></tr><tr><td port="LF16" height="32" width="2"></td></tr><tr><td port="LF17" height="46" width="2"></td></tr><tr><td height="12" width="2"></td></tr></table></td><td sides="b" border="1" height="30" width="230"><font point-size="16"><b>3.0</b></font></td><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="RS15" height="76" width="2"></td></tr><tr><td port="RS16" height="72" width="2"></td></tr><tr><td port="RS17" height="44" width="2"></td></tr><tr><td port="RS18" height="58" width="2"></td></tr><tr><td port="RS19" height="76" width="2"></td></tr><tr><td port="RS20" height="72" width="2"></td></tr><tr><td port="RS21" height="44" width="2"></td></tr><tr><td port="RS22" height="58" width="2"></td></tr><tr><td port="RS23" height="72" width="2"></td></tr><tr><td port="RS24" height="72" width="2"></td></tr><tr><td port="RS61" height="72" width="2"></td></tr></table></td></tr><tr><td height="532"><font point-size="20"><b>Capture work<br/>and evidence</b></font></td></tr><tr><td sides="t" border="1" height="154"><font point-size="16" color="#333333">editor saves under RLS;<br/>private-note RPCs;