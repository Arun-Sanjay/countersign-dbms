digraph L1 {
  graph [fontname="Helvetica", fontsize=20, labelloc=t, labeljust=l, pad=0.15,
         nodesep=0.19, ranksep=0.35, rankdir=LR, splines=true, newrank=true,
         label=<<b>DFD Level 1, sheet 1 of 8: process 1.0 Manage directory and enrollment</b>>];
  node  [fontname="Helvetica", fontsize=16];
  edge  [fontname="Helvetica", fontsize=14, arrowsize=1.0];
  "ADM@1.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="7" cellpadding="10"><font point-size="20"><b>College Admin</b></font></td><td port="p0" height="44" width="2"></td></tr><tr><td port="p1" height="44" width="2"></td></tr><tr><td port="p2" height="26" width="2"></td></tr><tr><td port="p3" height="44" width="2"></td></tr><tr><td port="p4" height="44" width="2"></td></tr><tr><td port="p5" height="44" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "STU@1.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="2" cellpadding="10"><font point-size="20"><b>Student</b></font></td><td port="p0" height="64" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "FAC@1.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="2" cellpadding="10"><font point-size="20"><b>Faculty</b></font></td><td port="p0" height="64" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "D15@1.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D15</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Ingest registry</b></font><br/><font point-size="16">team_repo, student_identity</font></td><td port="p0" height="58" width="2"></td></tr></table>>];
  "D1@1.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="118" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D1</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Directory and enrollment</b></font><br/><font point-size="16">student, faculty, course,<br/>academic_term,<br/>course_offering, enrollment,<br/>app_user</font></td></tr></table>>];
  "D2@1.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="62" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D2</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Projects and components</b></font><br/><font point-size="16">project, milestone</font></td></tr></table>>];
  "D3@1.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D3</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Teams</b></font><br/><font point-size="16">team, team_member</font></td></tr></table>>];
  "D4@1.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D4</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Work record</b></font><br/><font point-size="16">artifact, artifact_version,<br/>contribution</font></td></tr></table>>];
  "D6@1.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D6</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Claims</b></font><br/><font point-size="16">claim, claim_evidence,<br/>countersign</font></td></tr></table>>];
  "D7@1.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D7</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Submissions</b></font><br/><font point-size="16">submission,<br/>submission_artifact</font></td></tr></table>>];
  "1.0" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#f3f6fb"><tr><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td height="34" width="2"></td></tr><tr><td port="LF01" height="44" width="2"></td></tr><tr><td port="LF02" height="44" width="2"></td></tr><tr><td port="LF03" height="26" width="2"></td></tr><tr><td port="LF04" height="44" width="2"></td></tr><tr><td port="LF56" height="44" width="2"></td></tr><tr><td port="LF05" height="58" width="2"></td></tr><tr><td port="LF06" height="78" width="2"></td></tr><tr><td port="LF07" height="78" width="2"></td></tr><tr><td port="LS60" height="72" width="2"></td></tr><tr><td height="34" width="2"></td></tr></table></td><td sides="b" border="1" height="30" width="230"><font point-size="16"><b>1.0</b></font></td><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="RS01" height="132" width="2"></td></tr><tr><td port="RS02" height="76" width="2"></td></tr><tr><td port="RS03" height="72" width="2"></td></tr><tr><td port="RS04" height="92" width="2"></td></tr><tr><td port="RS05" height="92" width="2"></td></tr><tr><td port="RS06" height="92" width="2"></td></tr></table></td></tr><tr><td height="472"><font point-size="20"><b>Manage directory<br/>and enrollment</b></font></td></tr><tr><td sides="t" border="1" height="54"><font point-size="16" color="#333333">admin writes under RLS;<br/>semester_hub(), v_semester_hub</font></td></tr></table>>];
  { rank=same; "ADM@1.0"; "STU@1.0"; "FAC@1.0"; "D15@1.0"; }
  "ADM@1.0" -> "STU@1.0" -> "FAC@1.0" -> "D15@1.0" [style=invis];
  { rank=same; "1.0"; }
  { rank=same; "D1@1.0"; "D2@1.0"; "D3@1.0"; "D4@1.0"; "D6@1.0"; "D7@1.0"; }
  "D1@1.0" -> "D2@1.0" -> "D3@1.0" -> "D4@1.0" -> "D6@1.0" -> "D7@1.0" [style=invis];
  "ADM@1.0":p0:e -> "1.0":LF01:w [label="F01  directory records (student,\nfaculty, course)", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "ADM@1.0":p1:e -> "1.0":LF02:w [label="F02  term, offering and\nenrollment records", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "ADM@1.0":p2:e -> "1.0":LF03:w [label="F03  user-role mappings", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "ADM@1.0":p3:e -> "1.0":LF04:w [label="F04  project and component\ndefinitions", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "ADM@1.0":p4:e -> "1.0":LF56:w [label="F56  repository registrations\nand verified identities", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "ADM@1.0":p5:e -> "1.0":LF05:w [label="F05  directory listings and\ntotals", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "STU@1.0":p0:e -> "1.0":LF06:w [label="F06  semester hub", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "FAC@1.0":p0:e -> "1.0":LF07:w [label="F07  taught offerings and\nproject summaries", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "D15@1.0":p0:e -> "1.0":LS60:w [label="S60  team_repo, student_identity\n(admin writes)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "1.0":RS01:e -> "D1@1.0":p0:w [label="S01  student, faculty, course,\nacademic_term,\ncourse_offering,\nenrollment, app_user", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "1.0":RS02:e -> "D2@1.0":p0:w [label="S02  project, milestone\n(definitions, next\ndeadline)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=both];
  "1.0":RS03:e -> "D3@1.0":p0:w [label="S03  team, team_member", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "1.0":RS04:e -> "D4@1.0":p0:w [label="S04  artifact, artifact_version,\ncontribution (counts for\nthe faculty hub)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "1.0":RS05:e -> "D6@1.0":p0:w [label="S05  claim (status counts)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "1.0":RS06:e -> "D7@1.0":p0:w [label="S06  submission (counts for the\nfaculty hub)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
}
