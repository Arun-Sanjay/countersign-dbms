digraph L1 {
  graph [fontname="Helvetica", fontsize=20, labelloc=t, labeljust=l, pad=0.15,
         nodesep=0.19, ranksep=0.35, rankdir=LR, splines=true, newrank=true,
         label=<<b>DFD Level 1, sheet 6 of 8: process 6.0 Maintain skills and recommend teammates</b>>];
  node  [fontname="Helvetica", fontsize=16];
  edge  [fontname="Helvetica", fontsize=14, arrowsize=1.0];
  "ADM@6.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="2" cellpadding="10"><font point-size="20"><b>College Admin</b></font></td><td port="p0" height="64" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "STU@6.0" [shape=plain, label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="0" bgcolor="#e3e3e3"><tr><td rowspan="4" cellpadding="10"><font point-size="20"><b>Student</b></font></td><td port="p0" height="26" width="2"></td></tr><tr><td port="p1" height="26" width="2"></td></tr><tr><td port="p2" height="44" width="2"></td></tr><tr><td height="22" width="22" align="right" valign="bottom" cellpadding="0"><font point-size="20">&#x2571;</font></td></tr></table>>];
  "D6@6.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D6</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Claims</b></font><br/><font point-size="16">claim, claim_evidence,<br/>countersign</font></td><td port="p0" height="78" width="2"></td></tr></table>>];
  "D9@6.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td rowspan="2" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="2" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D9</b></font></td><td rowspan="2" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Skill graph</b></font><br/><font point-size="16">skill, student_skill,<br/>project_skill, course_skill,<br/>skill_evidence</font></td><td port="p0" height="80" width="2"></td></tr><tr><td port="p1" height="80" width="2"></td></tr></table>>];
  "D1@6.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="118" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D1</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Directory and enrollment</b></font><br/><font point-size="16">student, faculty, course,<br/>academic_term,<br/>course_offering, enrollment,<br/>app_user</font></td></tr></table>>];
  "D2@6.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D2</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Projects and components</b></font><br/><font point-size="16">project, milestone</font></td></tr></table>>];
  "D3@6.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="58" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D3</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Teams</b></font><br/><font point-size="16">team, team_member</font></td></tr></table>>];
  "D4@6.0" [shape=plain, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="p0" height="78" width="2"></td><td rowspan="1" sides="ltb" border="1" width="5" bgcolor="#e9f5ea"></td><td rowspan="1" sides="ltbr" border="1" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>D4</b></font></td><td rowspan="1" sides="tb" border="1" align="left" balign="left" bgcolor="#e9f5ea" cellpadding="6"><font point-size="18"><b>Work record</b></font><br/><font point-size="16">artifact, artifact_version,<br/>contribution</font></td></tr></table>>];
  "6.0" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#f3f6fb"><tr><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td port="LF33" height="78" width="2"></td></tr><tr><td port="LF34" height="26" width="2"></td></tr><tr><td port="LF35" height="26" width="2"></td></tr><tr><td port="LF36" height="58" width="2"></td></tr><tr><td port="LS44" height="92" width="2"></td></tr><tr><td port="LS41" height="80" width="2"></td></tr><tr><td port="LS42" height="94" width="2"></td></tr></table></td><td sides="b" border="1" height="30" width="230"><font point-size="16"><b>6.0</b></font></td><td rowspan="3" cellpadding="0"><table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td height="43" width="2"></td></tr><tr><td port="RS38" height="132" width="2"></td></tr><tr><td port="RS39" height="72" width="2"></td></tr><tr><td port="RS40" height="72" width="2"></td></tr><tr><td port="RS43" height="92" width="2"></td></tr><tr><td height="43" width="2"></td></tr></table></td></tr><tr><td height="350"><font point-size="20"><b>Maintain skills and<br/>recommend teammates</b></font></td></tr><tr><td sides="t" border="1" height="74"><font point-size="16" color="#333333">find_teammates(),<br/>find_full_cover(),<br/>skill_gap(), skill_subtree()</font></td></tr></table>>];
  { rank=same; "ADM@6.0"; "STU@6.0"; "D6@6.0"; "D9@6.0"; }
  "ADM@6.0" -> "STU@6.0" -> "D6@6.0" -> "D9@6.0" [style=invis];
  { rank=same; "6.0"; }
  { rank=same; "D1@6.0"; "D2@6.0"; "D3@6.0"; "D4@6.0"; }
  "D1@6.0" -> "D2@6.0" -> "D3@6.0" -> "D4@6.0" [style=invis];
  "ADM@6.0":p0:e -> "6.0":LF33:w [label="F33  skill taxonomy, required\nskills, course concepts,\nverified levels", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU@6.0":p0:e -> "6.0":LF34:w [label="F34  declared skill levels", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU@6.0":p1:e -> "6.0":LF35:w [label="F35  teammate / skill-gap query", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6];
  "STU@6.0":p2:e -> "6.0":LF36:w [label="F36  teammate suggestions and\nskill gap", color="#1f3b73", fontcolor="#1f3b73", penwidth=1.6, dir=back];
  "D6@6.0":p0:e -> "6.0":LS44:w [label="S44  claim, confirmed (to derive\nskill_evidence) [planned]", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, style=dashed];
  "D9@6.0":p0:e -> "6.0":LS41:w [label="S41  skill (recursive),\nstudent_skill,\nproject_skill,\nskill_evidence", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6];
  "D9@6.0":p1:e -> "6.0":LS42:w [label="S42  student_skill (own); skill,\nproject_skill,\ncourse_skill,\nskill_evidence (admin, F33)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "6.0":RS38:e -> "D1@6.0":p0:w [label="S38  student, enrollment\n(is_eligible_for_project)", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "6.0":RS39:e -> "D2@6.0":p0:w [label="S39  project", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "6.0":RS40:e -> "D3@6.0":p0:w [label="S40  team, team_member", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back];
  "6.0":RS43:e -> "D4@6.0":p0:w [label="S43  contribution (to derive\nskill_evidence) [planned]", color="#2f6f3e", fontcolor="#2f6f3e", penwidth=1.6, dir=back, style=dashed];
}
