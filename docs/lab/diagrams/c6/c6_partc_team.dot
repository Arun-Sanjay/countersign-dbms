// C6 Normalization - Figure 4: the 3NF-but-not-BCNF relation that exists in this schema
// TEAM_ASSIGNMENT(USN, Proj, Team) with  F = { USN,Proj -> Team ;  Team -> Proj }
// Render: docs/lab/build_c6.sh. Caption is in C6_Normalization.md.
digraph PartC {
  graph [rankdir=LR, nodesep=0.3, ranksep=0.5, fontname="DejaVu Sans", pad=0.2, bgcolor="white"];
  node  [fontname="DejaVu Sans", fontsize=13, shape=plain];
  edge  [fontname="DejaVu Sans", fontsize=12, color="#444444", arrowsize=0.8];

  r [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
    <TR><TD COLSPAN="3" BGCOLOR="#f4ecf7"><B>TEAM_ASSIGNMENT</B><BR/>keys {USN, Proj}, {USN, Team}</TD></TR>
    <TR><TD><U>USN</U></TD><TD><U>Proj</U></TD><TD>Team</TD></TR>
    <TR><TD COLSPAN="3" ALIGN="LEFT">FD1: USN, Proj &#8594; Team<BR ALIGN="LEFT"/>  one team per student<BR ALIGN="LEFT"/>  per project<BR ALIGN="LEFT"/>FD2: Team &#8594; Proj<BR ALIGN="LEFT"/>  a team belongs to<BR ALIGN="LEFT"/>  one project<BR ALIGN="LEFT"/><FONT COLOR="#7d3c98">FD2: Team is not a superkey;<BR ALIGN="LEFT"/>Proj is prime &#8658; 3NF holds,<BR ALIGN="LEFT"/>BCNF fails</FONT><BR ALIGN="LEFT"/></TD></TR>
   </TABLE>>];

  a [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#e8f5e9"><B>Option A: keep</B><BR/><B>(3NF, dependency-preserving)</B></TD></TR>
    <TR><TD ALIGN="LEFT">team(<U>team_id</U>, project_id, ...)<BR ALIGN="LEFT"/>  UNIQUE (team_id, project_id)<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT">team_member(<U>team_id</U>, <U>usn</U>, project_id)<BR ALIGN="LEFT"/>  UNIQUE (usn, project_id): FD1<BR ALIGN="LEFT"/>  FK (team_id, project_id) &#8594; team<BR ALIGN="LEFT"/>  keeps the copy of FD2 consistent<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#c0392b">cost: project_id repeated for every<BR ALIGN="LEFT"/>member (controlled redundancy)</FONT><BR ALIGN="LEFT"/></TD></TR>
   </TABLE>>];

  b [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#d6e4f0"><B>Option B: decompose on FD2</B><BR/><B>(BCNF, lossless): IMPLEMENTED</B></TD></TR>
    <TR><TD ALIGN="LEFT">team(<U>team_id</U>, project_id, topic_title, ...)<BR ALIGN="LEFT"/>  FD2 enforced by the PRIMARY KEY<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT">team_member(<U>team_id</U>, <U>usn</U>, role, joined_at)<BR ALIGN="LEFT"/>  no redundancy<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#c0392b">FD1 is not preserved</FONT>; enforced by<BR ALIGN="LEFT"/>trigger trg_team_one_per_project<BR ALIGN="LEFT"/>+ trg_team_project_guard<BR ALIGN="LEFT"/>(a staffed team cannot change project)<BR ALIGN="LEFT"/></TD></TR>
   </TABLE>>];

  r -> a [label="3NF\lsynthesis\l"];
  r -> b [label="BCNF\ldecomposition\lon Team &#8594; Proj\l", color="#1f3b5c", penwidth=1.6];
}
