// C10 Innovative Experiment - Figure 7: live wait-for graph, S2 at READ COMMITTED
// (experiments/race/results/demo_locks_S2_RC.txt). Render: docs/lab/build_c10.sh.
digraph WaitFor {
  graph [rankdir=TB, nodesep=0.4, ranksep=0.55, fontname="DejaVu Sans", pad=0.2, bgcolor="white"];
  node  [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", color="#1f3b5c", penwidth=1.3];
  edge  [fontname="DejaVu Sans", fontsize=10.5, color="#c0392b", fontcolor="#922b21", arrowsize=0.8, penwidth=1.5];

  C [label=<<B>race-C</B> (pid 887)<BR/>INSERT into team_member<BR/>trigger: SELECT ... FOR UPDATE<BR/><FONT COLOR="#922b21">waiting, Lock:tuple</FONT>>, fillcolor="#fdedec"];
  B [label=<<B>race-B</B> (pid 880)<BR/>holds the <B>tuple</B> lock on team (29,107)<BR/>= first in the queue<BR/><FONT COLOR="#922b21">waiting, Lock:transactionid</FONT>>, fillcolor="#fdedec"];
  A [label=<<B>race-A</B> (pid 873, xid 2314849)<BR/>row lock on team T02 (in the row header)<BR/>inserted the 4th member, sleeping<BR/><FONT COLOR="#1e8449">granted, not waiting</FONT>>, fillcolor="#e9f7ef", color="#1e8449"];

  C -> B [label="  wants tuple AccessExclusiveLock on team (29,107)"];
  B -> A [label="  wants ShareLock on transactionid 2314849 (\"wait until A ends\")"];
}
