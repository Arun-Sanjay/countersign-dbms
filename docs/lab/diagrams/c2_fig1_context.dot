// C2 SRS, Figure 1 (revision 1.2): Product perspective (system context).
// Solid = built and exercised by a recorded test run (C2_SRS.md §4, 5 Nov 2026).
// Dashed = specified, not built (only the AI model services remain).
// Dotted = a link by shared keys, not a network call.
digraph context {
    graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.3, ranksep=0.5, pad=0.15, newrank=true];
    node  [fontname="DejaVu Sans", fontsize=13, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#333333"];
    edge  [fontname="DejaVu Sans", fontsize=13, color="#333333", arrowsize=0.8];

    student [label="Student\n(U1)", style="filled", fillcolor="#eef3fb"];
    faculty [label="Faculty\n(U2)", style="filled", fillcolor="#eef3fb"];
    admin   [label="Administrator\n(U3)", style="filled", fillcolor="#eef3fb"];
    github  [label="GitHub\nteam repository\n(push webhook)", style="filled", fillcolor="#eef3fb"];
    { rank=same; student; faculty; admin; github; }

    subgraph cluster_system {
        label="Countersign (system boundary)"; labeljust=r; fontsize=13; style="rounded"; color="#1f4e79"; penwidth=1.6;
        web   [label="Web client\nReact 19 + TypeScript\n(Vite, Tailwind, shadcn)"];
        auth  [label="Supabase Auth\n(JWT, auth.uid())"];
        edgef [label="Edge Function\ngithub-webhook\n(HMAC check)"];
        api   [label="Data API (PostgREST)\ntables, views, RPCs;\nRealtime (broadcast)"];
        svc   [label="FastAPI service\nnotes, /consistency,\n/ask, /ingest/*;\ningest worker"];
        pg    [label="PostgreSQL 17\n29 public tables\n+ private.note, 6 views,\nRLS default-deny,\npgmq, pgvector"];
        mongo [label="MongoDB 8\nnotes, note_versions,\ngithub_events, portfolios"];
        { rank=same; web; auth; edgef; }
        { rank=same; svc; api; }
        { rank=same; pg; mongo; }
    }

    ai [label="AI model services (planned):\nVoyage AI embeddings,\nAnthropic Claude answers;\nsent only chunks the caller may read", style="rounded,dashed"];

    student -> web; faculty -> web; admin -> web;
    github -> edgef [label="signed push"];
    web -> auth [label="sign-in"];
    web -> api  [label="HTTPS + JWT"];
    web -> svc  [label="HTTPS + JWT"];
    edgef -> api [label="ingest_receive()"];
    api -> pg   [label="SQL as the\ncaller's role"];
    svc -> api  [label="caller's JWT;\nworker: service role", constraint=false];
    svc -> mongo [label="app user"];
    pg -> mongo [style=dotted, dir=both, label="shared keys:\nartifact_id, usn,\nteam_id, mongo_ref,\ncommit SHA", constraint=false];
    svc -> ai [style=dashed, dir=both];
    mongo -> ai [style=invis];
}
