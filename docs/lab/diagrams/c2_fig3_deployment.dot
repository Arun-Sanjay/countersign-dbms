// C2 SRS, Figure 3 (revision 1.2): Operating environment (deployment), top to bottom.
// Solid = running and exercised by a recorded test run; dashed = planned, not set up.
// The local verification environment (Docker) is listed in the table under the figure,
// not drawn, so that the figure stays legible in print.
// The cloud project countersign-dbms was checked on 5 Nov 2026 through the Supabase
// Management API: migrations 0001-0006 applied, status ACTIVE_HEALTHY, Edge Function
// github-webhook ACTIVE (C2_SRS.md §4, G7).
digraph deployment {
    graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.22, ranksep=0.45, pad=0.15,
           compound=true, newrank=true];
    node  [fontname="DejaVu Sans", fontsize=13, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#333333"];
    edge  [fontname="DejaVu Sans", fontsize=13, color="#333333", arrowsize=0.8];

    subgraph cluster_client {
        label="Client device (Windows, Linux,\nmacOS, Android, iOS)"; style=rounded; color="#666666";
        browser [label="Evergreen browser\n(Chrome, Edge,\nFirefox, Safari)"];
    }
    gh [label="GitHub\n(repository webhook)", fillcolor="#eef3fb"];
    { rank=same; browser; gh; }

    subgraph cluster_host {
        label="Application hosting"; style=rounded; color="#666666";
        devsrv [label="Vite server:\nthe SPA (local)"];
        fapi   [label="FastAPI + ingest\nworker, Python 3.12\n(running locally)"];
        vercel [label="Vercel: SPA and\nPython functions\n(planned)", style="rounded,dashed"];
    }

    subgraph cluster_supa {
        label="Supabase project\ncountersign-dbms\n(AWS ap-south-1, Mumbai)"; labelloc=b; style=rounded; color="#1f4e79"; penwidth=1.5;
        kong   [label="API gateway (TLS)"];
        efn    [label="Edge Function\ngithub-webhook"];
        rest   [label="PostgREST\n(Data API)"];
        gotrue [label="Auth\n(JWT issuer)"];
        rt     [label="Realtime\n(broadcast)"];
        db     [label="PostgreSQL 17.11\nschemas public, app,\nprivate, pgmq; pgvector", fillcolor="#fdf6e3"];
        { rank=same; efn; rest; gotrue; rt; }
    }

    subgraph cluster_atlas {
        label="MongoDB Atlas\n(shared tier)"; labelloc=b; style=rounded; color="#666666";
        mdb [label="MongoDB 8.0\ndatabase elp", fillcolor="#fdf6e3"];
    }
    { rank=same; db; mdb; }

    browser -> devsrv [label="HTTPS"];
    browser -> fapi   [label="HTTPS + JWT"];
    browser -> vercel [style=dashed];
    browser -> kong   [label="HTTPS + JWT\n(supabase-js)"];
    gh -> kong [label="HTTPS, HMAC"];
    kong -> efn; kong -> rest; kong -> gotrue; kong -> rt;
    efn -> db [label="ingest_\nreceive()"];
    rest -> db [label="caller's\nrole"];
    gotrue -> db;
    rt -> db [label="RLS on\nrealtime.\nmessages"];
    fapi -> kong [label="caller's JWT;\nworker:\nservice role"];
    fapi -> mdb  [label="TLS, app user"];
}
