# Copy to .env.local (local stack: `npm run env:local` writes it for you) or .env.remote (cloud).
# Only the PUBLISHABLE (anon) key belongs here. Never a service_role / secret key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
