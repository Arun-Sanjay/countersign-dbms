{
  "name": "countersign-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --mode remote",
    "build": "tsc -b && vite build",
    "build:remote": "tsc -b && vite build --mode remote",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --max-warnings 0",
    "env:local": "node scripts/write-env-local.mjs",
    "sql:extract": "node scripts/extract-sql.mjs",
    "types:gen": "cd .. && npx -y supabase@latest gen types typescript --schema public > web/src/data/database.types.ts && npx -y oxfmt web/src/data/database.types.ts",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
